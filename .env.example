DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=demo_rag
MONGODB_ROOMS_COLLECTION=rooms
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_TLS_CA_FILE=

RAG_API_KEY=
RAG_RATE_LIMIT_CACHE_ALIAS=default
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_RATE_LIMIT_MAX_REQUESTS=30

DJANGO_CACHE_REDIS_URL=
DJANGO_CACHE_KEY_PREFIX=nhatrovn
DJANGO_CACHE_DEFAULT_TIMEOUT=300

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ROOMS_COLLECTION=rooms_v1
QDRANT_SKIP_COMPAT_CHECK=true

KAFKA_BROKERS=localhost:9092

GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_REQUEST_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_DELAY_SECONDS=2

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VERSION=1
EMBEDDING_DTYPE=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANKER=false
RAG_LOW_VRAM_MODE=true
ROUTER_EMBEDDING_FALLBACK=false

TOP_K_RETRIEVAL=6
RETRIEVAL_CANDIDATE_LIMIT=100
TOP_K_RERANK=3
EVIDENCE_MAX_CHARS=3500
ANSWER_MAX_TOKENS=1024
MAX_USER_QUESTION_CHARS=1200
ENABLE_REVIEWER=false
MAX_REWRITE_RETRIES=0
METADATA_BOOST=0.5
METADATA_FIELDS=room_id,room_code,district,title,amenities,address
ENABLE_FEEDBACK_RETRY=true
FEEDBACK_MAX_RETRIEVAL_RETRIES=1
LOW_CONFIDENCE_MIN_DOCS=1
LOW_CONFIDENCE_MIN_SCORE=0.015

REDIS_SESSION_TTL_SECONDS=86400
REDIS_CACHE_TTL=604800
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
