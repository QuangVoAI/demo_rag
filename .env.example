# Runtime
HOST=127.0.0.1
PORT=8083
KAFKA_BROKERS=localhost:9092

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LISTINGS_COLLECTION=listings_v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VERSION=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# MongoDB listing source of truth
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nhatrovn
MONGODB_LISTINGS_COLLECTION=listings

# Redis session state/cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_SESSION_TTL_SECONDS=86400
REDIS_CACHE_TTL=604800
ENABLE_DYNAMIC_LISTING_ANSWER_CACHE=false

# Kafka topics
LISTING_CHANGED_TOPIC=listing.changed
LISTING_INDEX_DLQ_TOPIC=listing.index.dlq
LISTING_INDEX_MAX_ATTEMPTS=3

# Optional LLM/observability backends retained by existing project modules
GROQ_API_KEY=
GROQ_API_KEYS=
VERTEX_PROJECT_ID=
VERTEX_REGION=asia-southeast1
VERTEX_ENDPOINT_ID=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
