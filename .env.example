# Runtime
HOST=127.0.0.1
PORT=8083
KAFKA_BROKERS=localhost:9092
# Optional. Leave blank to auto-generate one consumer group per backend process.
KAFKA_RESPONSE_CONSUMER_GROUP_ID=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_ROOMS_COLLECTION=rooms_v1
QDRANT_SKIP_COMPAT_CHECK=true
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VERSION=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Low-VRAM RAG defaults for 4GB cards
RAG_LOW_VRAM_MODE=true
USE_RERANKER=false
TOP_K_RETRIEVAL=6
TOP_K_RERANK=3
EVIDENCE_MAX_CHARS=3500
ANSWER_MAX_TOKENS=1024
ENABLE_REVIEWER=false
MAX_REWRITE_RETRIES=0
ROUTER_EMBEDDING_FALLBACK=false
ENABLE_FEEDBACK_RETRY=true
FEEDBACK_MAX_RETRIEVAL_RETRIES=1
LOW_CONFIDENCE_MIN_DOCS=1
LOW_CONFIDENCE_MIN_SCORE=0.015
METADATA_BOOST=0.5
METADATA_FIELDS=room_id,district,title,amenities,address

# MongoDB room source of truth
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=demo_rag
MONGODB_ROOMS_COLLECTION=rooms

# Redis session state/cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_SESSION_TTL_SECONDS=86400
REDIS_CACHE_TTL=604800

# Kafka topics
ROOM_CHANGED_TOPIC=room.changed
ROOM_INDEX_DLQ_TOPIC=room.index.dlq
ROOM_INDEX_MAX_ATTEMPTS=3

# Optional LLM/observability backends retained by existing project modules
GROQ_API_KEY=
GROQ_API_KEYS=
VERTEX_PROJECT_ID=
VERTEX_REGION=asia-southeast1
VERTEX_ENDPOINT_ID=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
